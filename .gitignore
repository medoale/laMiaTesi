# Data directories (too large for GitHub, regenerate by running the scripts)
cveFixes/CVEfixes/Code/Data/CVEfixes.db
cveFixes/CVEfixes/Code/Data/json/
bigScraper/Data/

# criticalityScore: working state of a resumable run, deleted by the script
# itself once a run completes. The dated scored_<date>.csv snapshot is NOT
# ignored — that one is the deliverable.
criticalityScore/Data/*.partial
criticalityScore/Data/candidates.txt
criticalityScore/Data/candidates_remaining.txt
criticalityScore/Data/enumerate_chunks_done.txt
criticalityScore/Data/failed_repos.txt
criticalityScore/Data/scored_in_progress.csv
criticalityScore/Data/criticality_score_stderr.log


# Detached-run bookkeeping (per-machine, written by the run.sh/run_pipeline.sh wrappers)
run.log
run.pid



# Progress updates and their images (kept local, not versioned)
*-progress-alessandro.md
progress-images/

# Credentials — never commit these
googleKey.txt
*.CVEfixes.ini
.CVEfixes.ini

# Python
__pycache__/
*.pyc
*.pyo
venv/
venv2/
