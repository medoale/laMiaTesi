/work/install/db_scripts/db.sql:/* Table: adm_log_changes                                       */
/work/install/db_scripts/db.sql:/*    Generic table for logging changes to various other tables */
/work/install/db_scripts/db.sql:/*    The meaning of the subsequent columns depend heavily on   */
/work/install/db_scripts/db.sql:/*    the log_table field and describe entries in different     */
/work/install/db_scripts/db.sql:/*    tables. For this reason, no forein key restraints are     */
/work/install/db_scripts/db.sql:/*    possible (or even desired), since the original db record  */
/work/install/db_scripts/db.sql:/*    might even be deleted in the meantime. The corresponding  */
/work/install/db_scripts/db.sql:/*    log records, however, should still exist in the DB for    */
/work/install/db_scripts/db.sql:/*    audit reasons!                                            */
/work/install/db_scripts/db.sql:/*==============================================================*/
/work/install/db_scripts/db.sql:CREATE TABLE %PREFIX%_log_changes
/work/install/db_scripts/db.sql:(
/work/install/db_scripts/db.sql:    log_id                      integer             NOT NULL    AUTO_INCREMENT,
/work/install/db_scripts/db.sql:    log_table                   varchar(255)        NOT NULL, -- SQL table name without prefix
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:    log_record_id               integer unsigned    NOT NULL, -- The record id in the original table
/work/install/db_scripts/db.sql:    log_record_uuid             varchar(36)         NULL,     -- The record uuid in the original table
/work/install/db_scripts/db.sql:    log_record_name             text                NULL,     -- Textual representation in case the original record
/work/install/db_scripts/db.sql:                                                              -- no longer exists (e.g. group membership was deleted)
/work/install/db_scripts/db.sql:    log_record_linkid           text                NULL,     -- Record id for links (e.g. for memberships, the record_id
/work/install/db_scripts/db.sql:                                                              -- is mem_id, but the link should point to the group
/work/install/db_scripts/db.sql:                                                              -- (since the membership does not have its own page in admidio!)
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:    log_related_id              text                NULL,     -- Optional Secondary object linked to the record id
/work/install/db_scripts/db.sql:    log_related_name            text                NULL,     -- Textual representation in case the original record
/work/install/db_scripts/db.sql:                                                              -- no longer exists (e.g. group membership was deleted)
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:    log_field                   varchar(255)        NULL,     -- The id of the modified/affected field
/work/install/db_scripts/db.sql:    log_field_name              text                NULL,     -- Textual representation of the field
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:    log_action                  varchar(32)         NOT NULL, -- enum of "MODIFY", "CREATED", "DELETED"
/work/install/db_scripts/db.sql:    log_value_old               text                NULL,
/work/install/db_scripts/db.sql:    log_value_new               text                NULL,
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:    log_usr_id_create           integer unsigned    NULL,
/work/install/db_scripts/db.sql:    log_timestamp_create        timestamp           NOT NULL    DEFAULT CURRENT_TIMESTAMP,
/work/install/db_scripts/db.sql:    log_comment                 text                NULL,
/work/install/db_scripts/db.sql:    PRIMARY KEY (log_id)
/work/install/db_scripts/db.sql:)
/work/install/db_scripts/db.sql:ENGINE = InnoDB
/work/install/db_scripts/db.sql:DEFAULT CHARSET = utf8mb4
/work/install/db_scripts/db.sql:COLLATE = utf8mb4_unicode_ci;
/work/install/db_scripts/db.sql:
/work/install/db_scripts/db.sql:/*==============================================================*/
