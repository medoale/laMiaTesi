from email.message import Message

# Test 1: newline without header syntax
m = Message()
try:
    m['Subject'] = '[Parsec] malicious\njust a newline'
    print('Test 1 - No error with newline only')
    print(repr(str(m)))
except Exception as e:
    print(f'Test 1 - Error: {type(e).__name__}: {e}')

print()

# Test 2: newline with header-like content
m2 = Message()
try:
    m2['Subject'] = '[Parsec] test\nInjected: value'
    print('Test 2 - No error')
    print(repr(str(m2)))
except Exception as e:
    print(f'Test 2 - Error: {type(e).__name__}: {e}')

print()

# Test 3: RFC 2047 encoded word in header value (non-ASCII)
m3 = Message()
from email.header import Header
try:
    h = Header('test <script>alert(1)</script>'.encode('utf-8'), 'utf-8')
    m3['Subject'] = h
    print('Test 3 - No error')
    print(repr(str(m3)))
except Exception as e:
    print(f'Test 3 - Error: {type(e).__name__}: {e}')
"
