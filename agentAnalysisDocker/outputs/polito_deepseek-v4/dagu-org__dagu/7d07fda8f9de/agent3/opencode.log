[0m$ [0mcat > /tmp/test_quote.go << 'EOF'
package main

import (
	"fmt"
	"strconv"
)

func main() {
	payload := `{"cmd":"` + "`id`" + `"}`
	fmt.Printf("Original: %s\n", payload)
	quoted := strconv.Quote(payload)
	fmt.Printf("Quoted: %s\n", quoted)
	
	// What the webhook handler does:
	webhookParams := fmt.Sprintf("WEBHOOK_PAYLOAD=%s", strconv.Quote(payload))
	fmt.Printf("Webhook params: %s\n", webhookParams)
	
	// What SubCmdBuilder does (double quote):
	doubleQuoted := strconv.Quote(webhookParams)
	fmt.Printf("Double quoted: %s\n", doubleQuoted)
	
	// After RemoveQuotes
	fmt.Printf("After RemoveQuotes (simple trim): %s\n", stringutilRemoveQuotes(webhookParams))
}

func stringutilRemoveQuotes(s string) string {
	if len(s) >= 2 && s[0] == '"' && s[len(s)-1] == '"' {
		return s[1:len(s)-1]
	}
	if len(s) >= 2 && s[0] == '\'' && s[len(s)-1] == '\'' {
		return s[1:len(s)-1]
	}
	return s
}
EOF
