import ast, sys
# Search for patterns where variables are used as format strings in sprintf
for root, dirs, files in __import__('os').walk('/work/esphome/components'):
    for f in files:
        if f.endswith('.cpp') or f.endswith('.h'):
            path = __import__('os').path.join(root, f)
            try:
                with open(path) as fh:
                    content = fh.read()
                for lineno, line in enumerate(content.split('\n'), 1):
                    stripped = line.strip()
                    if 'sprintf' in stripped:
                        # Extract the arguments to sprintf
                        # Check if the format arg (2nd) is a variable, not a literal
                        if 'sprintf(' in stripped:
                            # Parse the bracket depth
                            depth = 0
                            start = stripped.find('sprintf(') + 8
                            for i, c in enumerate(stripped[start:], start):
                                if c == '(': depth += 1
                                elif c == ')': depth -= 1
                                if depth < 0:
                                    args_str = stripped[start:i]
                                    break
                            args = args_str.split(',', 3)
                            if len(args) >= 3:
                                fmt_arg = args[2].strip()
                                # Check if format arg is a string literal (starts with quote)
                                if not (fmt_arg.startswith('\"') or fmt_arg.startswith(\"'\")):
                                    print(f'{path}:{lineno}: {stripped[:150]}')
            except: pass
