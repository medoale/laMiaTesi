# Test path traversal bypasses for str.replace('..', '')
test_cases = [
    # Standard traversal
    '../../etc/passwd',
    # Bypass attempts for replace('..', '')
    '....//....//....//....//etc/passwd',
    '..../..../..../..../etc/passwd',
    '.../.../.../.../etc/passwd',
    '..\\..\\..\\..\\etc\\passwd',
    '....//etc/passwd',
    '....//....//etc/passwd',
    '.....///.....///etc/passwd',
    '.%2e/.%2e/.%2e/etc/passwd',
    '%2e%2e/%2e%2e/etc/passwd',
    '..;/..;/..;/etc/passwd',
    '..%252f..%252f..%252fetc%252fpasswd',
    '..%00/..%00/..%00/etc/passwd',
    '..\\x00/..\\x00/..\\x00/etc/passwd',
]

for tc in test_cases:
    result = tc.replace('..', '').lstrip('/')
    contains_dots = '..' in result
    print(f'Input: {tc!r}')
    print(f'  -> Result: {result!r}')
    print(f'  -> Contains ..: {contains_dots}')
    print()
