timestamp=2026-07-30T17:55:30.859Z level=INFO run=df74b639 message=evaluated permission=bash pattern="python3 -c \"\nimport ast, sys\n# Search for patterns where variables are used as format strings in sprintf\nfor root, dirs, files in __import__('os').walk('/work/esphome/components'):\n    for f in files:\n        if f.endswith('.cpp') or f.endswith('.h'):\n            path = __import__('os').path.join(root, f)\n            try:\n                with open(path) as fh:\n                    content = fh.read()\n                for lineno, line in enumerate(content.split('\\n'), 1):\n                    stripped = line.strip()\n                    if 'sprintf' in stripped:\n                        # Extract the arguments to sprintf\n                        # Check if the format arg (2nd) is a variable, not a literal\n                        if 'sprintf(' in stripped:\n                            # Parse the bracket depth\n                            depth = 0\n                            start = stripped.find('sprintf(') + 8\n                            for i, c in enumerate(stripped[start:], start):\n                                if c == '(': depth += 1\n                                elif c == ')': depth -= 1\n                                if depth < 0:\n                                    args_str = stripped[start:i]\n                                    break\n                            args = args_str.split(',', 3)\n                            if len(args) >= 3:\n                                fmt_arg = args[2].strip()\n                                # Check if format arg is a string literal (starts with quote)\n                                if not (fmt_arg.startswith('\\\"') or fmt_arg.startswith(\\\"'\\\")):\n                                    print(f'{path}:{lineno}: {stripped[:150]}')\n            except: pass\n\"" action.permission=bash action.action=allow action.pattern=*
