timestamp=2026-07-30T17:55:22.492Z level=INFO run=df74b639 message=evaluated permission=bash pattern="python3 -c \"\nimport ast, sys\n# Search for dangerous patterns in C++ files\nfor root, dirs, files in __import__('os').walk('/work/esphome/components'):\n    for f in files:\n        if f.endswith('.cpp') or f.endswith('.h'):\n            path = __import__('os').path.join(root, f)\n            try:\n                with open(path) as fh:\n                    content = fh.read()\n                for lineno, line in enumerate(content.split('\\n'), 1):\n                    stripped = line.strip()\n                    # Look for sprintf where 2nd arg is not a string literal\n                    if 'sprintf(' in stripped and 'this->' in stripped and 'c_str()' in stripped:\n                        print(f'{path}:{lineno}: {stripped[:120]}')\n            except: pass\n\"" action.permission=bash action.action=allow action.pattern=*
