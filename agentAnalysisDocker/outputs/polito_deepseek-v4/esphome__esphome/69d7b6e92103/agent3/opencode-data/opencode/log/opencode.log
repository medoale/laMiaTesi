timestamp=2026-07-30T17:55:19.501Z level=INFO run=df74b639 message=evaluated permission=bash pattern="python3 -c \"\nimport ast, sys\n# Search for eval/exec usage\nfor root, dirs, files in __import__('os').walk('/work/esphome'):\n    for f in files:\n        if f.endswith('.py'):\n            path = __import__('os').path.join(root, f)\n            try:\n                with open(path) as fh:\n                    content = fh.read()\n                for lineno, line in enumerate(content.split('\\n'), 1):\n                    stripped = line.strip()\n                    if stripped.startswith('eval(') or stripped.startswith('exec(') or ' eval(' in stripped or ' exec(' in stripped:\n                        print(f'{path}:{lineno}: {stripped[:100]}')\n            except: pass\n\"" action.permission=bash action.action=allow action.pattern=*
